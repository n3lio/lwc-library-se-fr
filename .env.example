# CCO FR Library — local build env vars
# Copy to .env (gitignored) and source it before running _build/* scripts,
# or export them in your shell rc file.

# Where the build_site.py picks up component preview images.
# Default: <repo>/_previews/ (created locally if missing).
# Maintainers: point to your Google Drive Desktop mount, e.g.
#   CCO_FR_PREVIEWS_DIR="$HOME/Library/CloudStorage/GoogleDrive-you@example.com/Mon Drive/LWC Library SE FR/Previews"
CCO_FR_PREVIEWS_DIR=

# Where sync_zips_to_drive.py copies the built _zips/*.zip artifacts.
# Default: ~/Library/CloudStorage/GoogleDrive-<owner>@example.com/Mon Drive/LWC Library SE FR/Sources
# Maintainers: point to the same Google Drive folder used for the Heroku site downloads.
CCO_FR_SOURCES_DIR=

# --- Heroku site runtime (production-only, set via `heroku config:set`) ---
# IP_HASH_SALT       — random string, used to anonymise visitor IPs in tracking
# SESSION_SECRET     — random string, used to sign admin-panel sessions
# OAUTH_HMAC_SECRET  — random string, used to sign OAuth state cookies
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
