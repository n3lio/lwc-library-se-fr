<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>CCO FR - Visit Check-In</masterLabel>
    <description>Check-in / Check-out d'une visite (Visit__c) : horodate CheckIn/CheckOut et fait évoluer VisitState__c. Écritures via updateRecord, sans Apex. Bilingue FR / EN.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Visit__c</object>
            </objects>
            <property name="language" type="String" default="fr" label="Langue de l'interface" description="'fr' (défaut) ou 'en'." />
            <property name="cardTitle" type="String" label="Titre de la carte (override)" />
            <property name="cardIcon" type="String" default="standard:activations" label="Icône de la carte" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
