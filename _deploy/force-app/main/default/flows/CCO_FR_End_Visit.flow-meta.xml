<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>CCO FR lib - Clôture une visite Visit__c (VisitState__c = Completed, CheckOutDateTime__c = maintenant). Court-circuite si la visite est déjà clôturée. Le Flow ne lance pas la synthèse IA : le composant seFrVisitSummaryAI la génère à l'ouverture de la fiche quand l'état est Completed.</description>
    <environments>Default</environments>
    <interviewLabel>{!$Flow.CurrentDateTime} - CCO FR - End Visit</interviewLabel>
    <label>CCO FR — Clôturer la visite</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <decisions>
        <name>isAlreadyCompleted</name>
        <label>Déjà clôturée ?</label>
        <locationX>380</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>confirmScreen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Non</defaultConnectorLabel>
        <rules>
            <name>AlreadyCompleted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getVisit.VisitState__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>alreadyDoneScreen</targetReference>
            </connector>
            <label>Oui</label>
        </rules>
    </decisions>
    <decisions>
        <name>launchSummaryDecision</name>
        <label>Synthèse IA demandée ?</label>
        <locationX>176</locationX>
        <locationY>758</locationY>
        <defaultConnector>
            <targetReference>doneScreen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Non</defaultConnectorLabel>
        <rules>
            <name>SummaryRequested</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>LaunchSummary</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>doneWithSummaryScreen</targetReference>
            </connector>
            <label>Oui</label>
        </rules>
    </decisions>
    <recordLookups>
        <name>getVisit</name>
        <label>Lire la visite</label>
        <locationX>380</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>getAccount</targetReference>
        </connector>
        <faultConnector>
            <targetReference>errorScreen</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Visit__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>getAccount</name>
        <label>Lire le compte</label>
        <locationX>380</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>isAlreadyCompleted</targetReference>
        </connector>
        <faultConnector>
            <targetReference>errorScreen</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>getVisit.Account__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>closeVisit</name>
        <label>Clôturer la visite</label>
        <locationX>176</locationX>
        <locationY>650</locationY>
        <connector>
            <targetReference>launchSummaryDecision</targetReference>
        </connector>
        <faultConnector>
            <targetReference>errorScreen</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>CheckOutDateTime__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>VisitState__c</field>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </inputAssignments>
        <object>Visit__c</object>
    </recordUpdates>
    <screens>
        <name>confirmScreen</name>
        <label>Clôturer la visite ?</label>
        <locationX>176</locationX>
        <locationY>542</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>closeVisit</targetReference>
        </connector>
        <fields>
            <name>visitInfo</name>
            <fieldType>DisplayText</fieldType>
            <fieldText>&lt;p&gt;&lt;strong&gt;Clôturer la visite ?&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Compte : {!getAccount.Name}&lt;/p&gt;&lt;p&gt;État actuel : {!getVisit.VisitState__c}&lt;/p&gt;&lt;p&gt;Check-in : {!getVisit.CheckInDateTime__c}&lt;/p&gt;</fieldText>
        </fields>
        <fields>
            <name>LaunchSummary</name>
            <dataType>Boolean</dataType>
            <defaultValue>
                <booleanValue>true</booleanValue>
            </defaultValue>
            <fieldText>Lancer la synthèse Agentforce après clôture</fieldText>
            <fieldType>InputField</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Clôturer la visite</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>alreadyDoneScreen</name>
        <label>Déjà clôturée</label>
        <locationX>584</locationX>
        <locationY>458</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
