        <allowPause>false</allowPause>
        <fields>
            <name>doneWithSummaryText</name>
            <fieldType>DisplayText</fieldType>
            <fieldText>&lt;p&gt;&lt;strong&gt;Visite clôturée.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;La synthèse IA se générera automatiquement à l'ouverture de la fiche.&lt;/p&gt;</fieldText>
        </fields>
        <nextOrFinishButtonLabel>Fermer</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>doneScreen</name>
        <label>Visite clôturée</label>
        <locationX>314</locationX>
        <locationY>866</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>doneText</name>
            <fieldType>DisplayText</fieldType>
            <fieldText>&lt;p&gt;&lt;strong&gt;Visite clôturée.&lt;/strong&gt;&lt;/p&gt;</fieldText>
        </fields>
        <nextOrFinishButtonLabel>Fermer</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>errorScreen</name>
        <label>Erreur</label>
        <locationX>800</locationX>
        <locationY>350</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>errorText</name>
            <fieldType>DisplayText</fieldType>
            <fieldText>&lt;p&gt;&lt;strong&gt;Impossible de clôturer la visite.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;&lt;p&gt;&lt;em&gt;Causes fréquentes : permset CCO_FR_Retail_Exec non assigné, recordId qui n'est pas une Visite, ou validation rule custom sur Visit__c.&lt;/em&gt;&lt;/p&gt;</fieldText>
        </fields>
        <nextOrFinishButtonLabel>Fermer</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>getVisit</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>Id de la Visit__c à clôturer. Passed in par le LWC lanceur ou le bouton d'action.</description>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
