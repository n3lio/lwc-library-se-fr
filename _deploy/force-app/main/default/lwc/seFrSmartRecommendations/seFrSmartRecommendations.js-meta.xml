<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>SE FR - Smart Recommendations</masterLabel>
    <description>Context-aware recommended actions (Next Best Action).</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Account</object>
                <object>Contact</object>
                <object>Case</object>
                <object>Order</object>
            </objects>
            
            <property name="language" type="String" default="fr" label="UI language" description="'en' (default) or 'fr'. Controls card title, subtitle, empty state, Dismiss button, relevance badge prefix, toast messages and the per-object default recommendations (Case, Account, Order, Contact)." />
            <property name="cardTitle" type="String" label="Card title (override)" />
            <property name="displayMode" type="String" datasource="Global,Targeted" default="Global" label="Display mode" description="Global = show on every record. Targeted = only on the record IDs specified below."/>

            <property name="targetId1" type="String" label="[Target 1] Record ID" />
            <property name="targetRecos1" type="String" label="[Target 1] Recommendations to show (e.g. 1,3,4)" />
            <property name="targetId2" type="String" label="[Target 2] Record ID" />
            <property name="targetRecos2" type="String" label="[Target 2] Recommendations to show (e.g. 2,5)" />
            <property name="targetId3" type="String" label="[Target 3] Record ID" />
            <property name="targetRecos3" type="String" label="[Target 3] Recommendations to show" />

            <property name="customTitle1" type="String" label="Reco 1 - Title (action)" />
            <property name="customDesc1" type="String" label="Reco 1 - Reason (description)" />
            <property name="customTitle2" type="String" label="Reco 2 - Title" />
            <property name="customDesc2" type="String" label="Reco 2 - Reason" />
            <property name="customTitle3" type="String" label="Reco 3 - Title" />
            <property name="customDesc3" type="String" label="Reco 3 - Reason" />
            <property name="customTitle4" type="String" label="Reco 4 - Title" />
            <property name="customDesc4" type="String" label="Reco 4 - Reason" />
            <property name="customTitle5" type="String" label="Reco 5 - Title" />
            <property name="customDesc5" type="String" label="Reco 5 - Reason" />
            <property name="customTitle6" type="String" label="Reco 6 - Title" />
            <property name="customDesc6" type="String" label="Reco 6 - Reason" />

            <property name="globalTitle1" type="String" label="[Global] Reco 1 - Title" description="Shown on every record of this object when set. Overrides the built-in per-object default." />
            <property name="globalDesc1"  type="String" label="[Global] Reco 1 - Reason" />
            <property name="globalBtn1"   type="String" label="[Global] Reco 1 - Button label" />
            <property name="globalTitle2" type="String" label="[Global] Reco 2 - Title" />
            <property name="globalDesc2"  type="String" label="[Global] Reco 2 - Reason" />
            <property name="globalBtn2"   type="String" label="[Global] Reco 2 - Button label" />
            <property name="globalTitle3" type="String" label="[Global] Reco 3 - Title" />
            <property name="globalDesc3"  type="String" label="[Global] Reco 3 - Reason" />
            <property name="globalBtn3"   type="String" label="[Global] Reco 3 - Button label" />
            <property name="globalTitle4" type="String" label="[Global] Reco 4 - Title" />
            <property name="globalDesc4"  type="String" label="[Global] Reco 4 - Reason" />
            <property name="globalBtn4"   type="String" label="[Global] Reco 4 - Button label" />
            <property name="globalTitle5" type="String" label="[Global] Reco 5 - Title" />
            <property name="globalDesc5"  type="String" label="[Global] Reco 5 - Reason" />
            <property name="globalBtn5"   type="String" label="[Global] Reco 5 - Button label" />
            <property name="globalTitle6" type="String" label="[Global] Reco 6 - Title" />
            <property name="globalDesc6"  type="String" label="[Global] Reco 6 - Reason" />
            <property name="globalBtn6"   type="String" label="[Global] Reco 6 - Button label" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>