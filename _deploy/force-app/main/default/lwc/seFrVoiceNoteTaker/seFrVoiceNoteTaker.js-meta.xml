<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>SE FR - Voice Note Taker</masterLabel>
    <description>Dictate a voice note and save it as a completed Task linked to the current record. Bilingual EN / FR.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Account</object>
                <object>Contact</object>
                <object>Lead</object>
                <object>Opportunity</object>
            </objects>
            <property name="language" type="String" default="fr" label="UI language" description="'en' (default) or 'fr'. Controls every visible string. Explicit values override per-field." />
            <property name="cardTitle" type="String" label="Card title (override)" />
            <property name="cardIcon" type="String" default="standard:voice_call" label="Card icon" />
            <property name="speechLocale" type="String" default="fr-FR" label="Speech recognition locale" description="BCP 47 tag (e.g. en-US, fr-FR). Independent of the UI language - set it to the language the user will actually speak." />
            <property name="taskSubject" type="String" label="Task subject (override)" />
            <property name="recordingHint" type="String" label="Recording hint text (override)" />
            <property name="textareaLabel" type="String" label="Textarea label (override)" />
            <property name="textareaPlaceholder" type="String" label="Textarea placeholder (override)" />
            <property name="startButtonLabel" type="String" label="Start button label (override)" />
            <property name="stopButtonLabel" type="String" label="Stop button label (override)" />
            <property name="saveButtonLabel" type="String" label="Save button label (override)" />
            <property name="unsupportedBrowserMessage" type="String" label="Unsupported-browser message (override)" />
            <property name="successMessage" type="String" label="Success toast message (override)" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
