<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>CCO FR - Visit Shelf Space</masterLabel>
    <description>Relevé linéaire manuel : facings par catégorie/segment, Marque vs Concurrence, PDL calculée et évolution vs visite précédente. Publie en localStorage pour cocher l'étape shelf du seFrVisitPlan.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <supportedFormFactors>
                <supportedFormFactor type="Large"/>
                <supportedFormFactor type="Small"/>
            </supportedFormFactors>
            <objects>
                <object>Visit__c</object>
            </objects>
            <property name="language"         type="String"  default="fr" label="Langue" description="'fr' ou 'en'." />
            <property name="cardTitle"        type="String"               label="Titre de la carte (override)" />
            <property name="cardIcon"         type="String"               label="Icône SLDS (override)" description="Défaut : standard:merchandising." />
            <property name="brandName"        type="String"  default="Ma marque" label="Nom de la marque principale" description="Libellé affiché pour les lignes 'main' (ex: Danone, LU, DIM)." />
            <property name="competitorLabel"  type="String"               label="Libellé concurrence (override)" description="Défaut : 'Concurrence' / 'Competition'." />
            <property name="seedJson"         type="String"               label="Catalogue JSON (override)" description="JSON Array des catégories/segments/marques pour remplacer le seed par défaut. Voir README." />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
