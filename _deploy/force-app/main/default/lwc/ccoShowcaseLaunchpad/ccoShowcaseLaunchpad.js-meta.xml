<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>CCO FR Showcase - Launchpad</masterLabel>
    <description>Showcase app only (not in the library). Visual launchpad of tiles that guide the visitor to each persona home and record page of the app.</description>
    <targets>
        <target>lightning__HomePage</target>
        <target>lightning__AppPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__HomePage,lightning__AppPage">
            <property name="language" type="String" default="fr" label="UI language (fr | en)" />
            <property name="cardTitle" type="String" label="Title (override)" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
