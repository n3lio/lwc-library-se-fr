<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>CCO FR - Visit Shelf Compliance</masterLabel>
    <description>Retail Execution - Shelf photo compliance on a Visit. Upload photos, view the gallery and run an Agentforce shelf analysis (occupancy, missing facings, misplaced products). Mock-first: works without Agentforce.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Visit__c</object>
            </objects>
            <property name="language" type="String" default="fr" label="UI language" description="fr or en."/>
            <property name="cardTitle" type="String" default="Conformité du linéaire" label="Card title"/>
            <property name="cardIcon" type="String" default="standard:product_item" label="Card icon"/>
            <property name="maxFiles" type="Integer" default="6" label="Max files per upload" description="1 to 6."/>
            <property name="promptTemplateApiName" type="String" label="Prompt template API name (optional)" description="Agentforce prompt template. Leave blank to use the mock result."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
