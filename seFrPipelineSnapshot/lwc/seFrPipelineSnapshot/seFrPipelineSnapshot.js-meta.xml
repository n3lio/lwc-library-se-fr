<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>CCO FR - Pipeline Snapshot</masterLabel>
    <description>B2B - Customer pipeline visualisation: open Opportunities grouped by Stage with per-column totals, unweighted and weighted totals at the top.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Account</object>
                <object>Opportunity</object>
            </objects>
            <property name="language" type="String" default="fr" label="UI language" description="'en' (default) or 'fr'. Controls card title, tile labels, stage column names. Raw StageName values flow through unchanged." />
            <property name="cardTitle" type="String" label="Card title (override)" />
            <property name="cardIcon" type="String" default="standard:opportunity" label="Card icon" />
            <property name="currencyCode" type="String" default="EUR" label="Currency code (ISO 4217)" />
            <property name="localeTag" type="String" default="fr-FR" label="Locale tag" />
            <property name="limitCount" type="Integer" default="40" label="Max opportunities" description="Server-side LIMIT (1-200)." />
            <property name="includeClosed" type="Boolean" default="false" label="Include closed opportunities" description="Off by default - only open Opps are shown." />
            <property name="hideNewOppButton" type="Boolean" default="false" label="Hide 'New opportunity' button" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
